<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限（原有） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 悬浮窗权限（必须） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务权限（Android 9+ 需要） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 录屏权限无需额外声明，由 MediaProjection 动态申请 -->

    <application
        android:allowBackup="true"
        android:label="BabyJie"
        android:supportsRtl="true"
        android:theme="@style/Theme.BabyJie">

        <!-- 启动页 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 校验等待页（注意：若实际类在 com.babyjie.ui 包下，则保持 .ui.CheckActivity） -->
        <activity
            android:name=".ui.CheckActivity"
            android:exported="false" />

        <!-- 横竖屏选择页 -->
        <activity
            android:name=".ui.OrientationActivity"
            android:exported="false" />

        <!-- 悬浮窗服务 -->
        <service
            android:name=".FloatWindowService"
            android:exported="false" />

        <!-- 录屏画面捕捉服务（Android 10+ 需要 foregroundServiceType） -->
        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

    </application>
</manifest>
