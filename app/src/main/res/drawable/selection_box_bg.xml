<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内部柔光填充 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FF69B4" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 发光外描边 -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2.5dp" android:color="#CCFF69B4" />
            <corners android:radius="12dp" />
            <padding android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp" />
        </shape>
    </item>
    <!-- 内部虚线指示 -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#40FFFFFF" android:dashWidth="10dp" android:dashGap="6dp" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
