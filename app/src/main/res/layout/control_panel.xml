<?xml version="1.0" encoding="utf-8"?>
<!-- File: app/src/main/res/layout/control_panel.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/transparent">
    
    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />
    
    <!-- 主瞄准线开关 -->
    <Switch
        android:id="@+id/switchMainLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_line"
        android:textColor="@android:color/white" />
    
    <!-- 目标球延伸线开关 -->
    <Switch
        android:id="@+id/switchTargetLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/target_line"
        android:textColor="@android:color/white" />
    
    <!-- 库边反弹线开关 -->
    <Switch
        android:id="@+id/switchReboundLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rebound_line"
        android:textColor="@android:color/white" />
    
    <!-- 力度条开关 -->
    <Switch
        android:id="@+id/switchPowerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/power_bar"
        android:textColor="@android:color/white" />
    
    <!-- AI推荐路线开关 -->
    <Switch
        android:id="@+id/switchAIRecommend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_recommend"
        android:textColor="@android:color/white" />
    
    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginVertical="12dp" />
    
    <!-- 调整识别区域按钮 -->
    <Button
        android:id="@+id/btnAdjustArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adjust_area"
        android:backgroundTint="@color/gold"
        android:textColor="@android:color/black" />
    
    <!-- 打开设置页按钮 -->
    <Button
        android:id="@+id/btnOpenSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_settings"
        android:backgroundTint="@color/gold"
        android:textColor="@android:color/black" />
    
    <!-- 关闭悬浮窗按钮 -->
    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/close_overlay"
        android:backgroundTint="@color/red"
        android:textColor="@android:color/white" />
    
</LinearLayout>
