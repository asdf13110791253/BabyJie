<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/card_dark_background"
    android:minWidth="220dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/rose_pink"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Switch
        android:id="@+id/switchMainLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_line"
        android:textColor="@color/text_primary"
        android:paddingVertical="4dp" />

    <Switch
        android:id="@+id/switchTargetLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/target_line"
        android:textColor="@color/text_primary"
        android:paddingVertical="4dp" />

    <Switch
        android:id="@+id/switchReboundLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rebound_line"
        android:textColor="@color/text_primary"
        android:paddingVertical="4dp" />

    <Switch
        android:id="@+id/switchPowerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/power_bar"
        android:textColor="@color/text_primary"
        android:paddingVertical="4dp" />

    <Switch
        android:id="@+id/switchAIRecommend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_recommend"
        android:textColor="@color/text_primary"
        android:paddingVertical="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        android:layout_marginVertical="12dp" />

    <!-- 新增：设置按钮，对应 ControlPanelView 中的 btnOpenSettings -->
    <Button
        android:id="@+id/btnOpenSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:background="@drawable/button_rose_selector"
        android:textColor="@color/text_on_rose"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAdjustArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adjust_area"
        android:background="@drawable/button_rose_selector"
        android:textColor="@color/text_on_rose"
        android:layout_marginBottom="8dp" />

    <!-- 保留 btnClose，与 ControlPanelView 中的引用一致 -->
    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close_overlay"
        android:backgroundTint="@color/rose_pink_dark"
        android:textColor="@color/text_on_rose" />

</LinearLayout>
