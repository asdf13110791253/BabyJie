<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFB6C1">

    <!-- 视频层 -->
    <com.babyjie.ExoPlayerVideoView
        android:id="@+id/exoPlayerVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部渐变遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top" />

    <!-- 底部渐变遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom" />

    <!-- 彩色字母品牌动画区域 -->
    <LinearLayout
        android:id="@+id/llBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tvLetter1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B"
            android:textColor="#FF69B4"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF69B4"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="a"
            android:textColor="#FF85C1"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF85C1"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="b"
            android:textColor="#FFA0D0"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FFA0D0"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="y"
            android:textColor="#FF69B4"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF69B4"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J"
            android:textColor="#FF85C1"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF85C1"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="i"
            android:textColor="#FFA0D0"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FFA0D0"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="e"
            android:textColor="#FF69B4"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF69B4"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />
    </LinearLayout>

    <!-- 跳过按钮 -->
    <TextView
        android:id="@+id/tvSkipCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_skip_button"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="10"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:fontFamily="sans-serif-medium" />

    <!-- 底部玻璃文字 + 彩色加载条 -->
    <com.babyjie.GlassLoadingTextView
        android:id="@+id/glassLoadingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:text="Babyje"
        android:textSize="170sp" />

    <!-- 防沉迷提示（最底部，极小字，启动后显示，进入免责声明后隐藏） -->
    <TextView
        android:id="@+id/tvAntiAddiction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:text="抵制不良游戏，拒绝盗版游戏。注意自我保护，谨防受骗上当。"
        android:textColor="#50FFFFFF"
        android:textSize="7sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingLeft="20dp"
        android:paddingRight="20dp" />

    <!-- ================== 免责声明层（保持不变） ================== -->
    <FrameLayout
        android:id="@+id/disclaimerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0A1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- 免责声明内容与之前一致，此处省略 -->
    </FrameLayout>

</FrameLayout>
