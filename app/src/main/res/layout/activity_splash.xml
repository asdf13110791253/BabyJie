<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFB6C1">

    <com.babyjie.ExoPlayerVideoView
        android:id="@+id/exoPlayerVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部渐变遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top" />

    <!-- 底部渐变遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom" />

    <!-- 炫彩字母区域 -->
    <LinearLayout
        android:id="@+id/llBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tvLetter1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B"
            android:textColor="#FF3366"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF3366"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/tvLetter2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="a"
            android:textColor="#FF6EC7"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF6EC7"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/tvLetter3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="b"
            android:textColor="#9B59B6"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#809B59B6"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/tvLetter4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="y"
            android:textColor="#3498DB"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#803498DB"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/tvLetter5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J"
            android:textColor="#1ABC9C"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#801ABC9C"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/tvLetter6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="i"
            android:textColor="#F1C40F"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80F1C40F"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/tvLetter7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="e"
            android:textColor="#E67E22"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80E67E22"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

    </LinearLayout>

    <!-- 跳过按钮 -->
    <TextView
        android:id="@+id/tvSkipCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_skip_button"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="10"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:fontFamily="sans-serif-medium"
        android:visibility="visible" />

</FrameLayout>
