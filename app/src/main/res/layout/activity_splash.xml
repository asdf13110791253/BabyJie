<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFB6C1">

    <!-- 视频层 -->
    <com.babyjie.ExoPlayerVideoView
        android:id="@+id/exoPlayerVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部渐变遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top" />

    <!-- 底部渐变遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom" />

    <!-- 彩色字母品牌动画区域 -->
    <LinearLayout
        android:id="@+id/llBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tvLetter1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B"
            android:textColor="#FF69B4"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF69B4"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="a"
            android:textColor="#FF85C1"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF85C1"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="b"
            android:textColor="#FFA0D0"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FFA0D0"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="y"
            android:textColor="#FF69B4"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF69B4"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J"
            android:textColor="#FF85C1"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF85C1"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="i"
            android:textColor="#FFA0D0"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FFA0D0"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/tvLetter7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="e"
            android:textColor="#FF69B4"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:alpha="0"
            android:shadowColor="#80FF69B4"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />
    </LinearLayout>

    <!-- 跳过按钮 -->
    <TextView
        android:id="@+id/tvSkipCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_skip_button"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="10"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:fontFamily="sans-serif-medium" />

    <!-- 底部玻璃文字 + 彩色加载条 -->
    <com.babyjie.GlassLoadingTextView
        android:id="@+id/glassLoadingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="15dp"
        android:text="Babyje"
        android:textSize="170sp" />

    <!-- ================== 免责声明层 ================== -->
    <FrameLayout
        android:id="@+id/disclaimerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0A1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/disclaimer_bg_gradient" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="80dp"
            android:paddingBottom="30dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <!-- 应用图标 -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_launcher_temp"
                android:scaleType="fitCenter"
                android:layout_marginBottom="16dp" />

            <!-- 应用名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BabyJie"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <!-- 副标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="台球智能助手 · 科技与娱乐"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <!-- 粉色渐变分割线 -->
            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:background="@drawable/disclaimer_divider"
                android:layout_marginBottom="24dp" />

            <!-- 文本卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/disclaimer_text_card_bg"
                android:padding="20dp"
                android:clipToPadding="false">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvDisclaimerText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/disclaimer_text"
                        android:textColor="#E0FFFFFF"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.6" />
                </ScrollView>
            </LinearLayout>

            <!-- “联系开发者”按钮（保存二维码） -->
            <TextView
                android:id="@+id/btnContactDev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="联系开发者微信"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_save_button" />

            <!-- “同意并进入”按钮（和上面样式一致） -->
            <TextView
                android:id="@+id/btnAgreeEnter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="同意并进入"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_save_button" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
