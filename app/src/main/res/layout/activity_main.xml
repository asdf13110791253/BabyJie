<?xml version="1.0" encoding="utf-8"?>
<!-- File: app/src/main/res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/dark_background">
    
    <!-- 应用图标 -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_menu_camera"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/app_name" />
    
    <!-- 应用名称 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/gold"
        android:layout_marginBottom="8dp" />
    
    <!-- 应用描述 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_description"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="32dp" />
    
    <!-- 权限状态 -->
    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/overlay_permission_status"
        android:textSize="14sp"
        android:textColor="@android:color/holo_red_dark"
        android:layout_marginBottom="24dp" />
    
    <!-- 启动按钮 -->
    <Button
        android:id="@+id/btnStartAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_assistant"
        android:textSize="18sp"
        android:backgroundTint="@color/gold"
        android:textColor="@android:color/black"
        android:padding="12dp" />
    
    <!-- 停止按钮 -->
    <Button
        android:id="@+id/btnStopAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/stop_assistant"
        android:textSize="18sp"
        android:backgroundTint="@color/red"
        android:textColor="@android:color/white"
        android:padding="12dp" />
    
    <!-- 使用说明 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/usage_instructions"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:gravity="center" />
    
</LinearLayout>
