<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/params_panel_bg"
    android:padding="16dp">

    <!-- 标题栏（可拖动） -->
    <TextView
        android:id="@+id/tvPanelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="台球参数"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- 力度滑块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="力度"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvPowerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50"
                android:textColor="#FF69B4"
                android:textSize="13sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/sbPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:thumb="@drawable/seekbar_thumb"
            android:progressDrawable="@drawable/seekbar_progress" />
    </LinearLayout>

    <!-- 角度滑块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="角度"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvAngleValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45"
                android:textColor="#FF69B4"
                android:textSize="13sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/sbAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90"
            android:progress="45"
            android:thumb="@drawable/seekbar_thumb"
            android:progressDrawable="@drawable/seekbar_progress" />
    </LinearLayout>

    <!-- 灵敏度滑块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="灵敏度"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSensitivityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#FF69B4"
                android:textSize="13sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/sbSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="5"
            android:thumb="@drawable/seekbar_thumb"
            android:progressDrawable="@drawable/seekbar_progress" />
    </LinearLayout>

    <!-- 完成按钮 -->
    <TextView
        android:id="@+id/btnParamsDone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="完成"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/btn_done_bg" />
</LinearLayout>
